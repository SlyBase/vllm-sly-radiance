+// The int4 (KV4) cache: O_KV4I on the double-buffered byte legs, tile 16/32/48 (R4D_ATTN_TILE).
+// Opt-in: nothing in this library calls it, and it refuses to run unless R4D_KV4I=1.
+extern "C" int r4d_attn_prefill_h256_gqa6_int4kv(const R4DArgs* a, hipStream_t s) {
+    static const bool on = [] { const char* e = getenv("R4D_KV4I"); return e && atoi(e) == 1; }();
+    if (!on) return -5;
+    if (a->head_dim != A_HEAD_DIM || a->block_size != A_BLOCK_SIZE) return -1;
+    if (a->q_heads / a->kv_heads != A_GQA) return -2;
+    constexpr int BQ = (P_NWARPS * 16) / A_GQA;
+    dim3 grid((a->q_len + BQ - 1) / BQ, a->kv_heads, a->num_seqs);
+    R4DArgs ab = *a;
+    const float qs = r4d_q_fp8();
+    ab.q_scale = qs;
+    const char* et = getenv("R4D_ATTN_TILE");
+    const int t = et ? atoi(et) : P_TILE;
+    // No O_FOLDQ: the fold multiplies scale/HEAD*log2e into the query BEFORE the e4m3 pack, which puts
+    // 98 % of the elements under e4m3's 2^-6 (subnormal, <= 3 bits usable, flushing to 0 at 2^-9) --
+    // measured on a dumped launch: rel-L2 6.2 % -> 4.6 % and half the output shrink with the fold off,
+    // the scale costs 8 f32 multiplies per m-tile instead. See docs/R4D-INT4-PREFILL.md.
+    constexpr int B = (P_OPT & ~O_FOLDQ) | O_QK8 | O_PV8 | O_DB | O_KV4I;
+#define K4_L(TILEX)                                                                               \
+    do {                                                                                          \
+        if (qs > 0.0f)                                                                            \
+            hipLaunchKernelGGL((r4d_attn_prefill_kernel<P_NWARPS, TILEX, A_HEAD_DIM, A_GQA,       \
+                                A_BLOCK_SIZE, 0, B | O_QF8>), grid, dim3(P_NWARPS * 32), 0, s, ab); \
+        else                                                                                      \
+            hipLaunchKernelGGL((r4d_attn_prefill_kernel<P_NWARPS, TILEX, A_HEAD_DIM, A_GQA,       \
+                                A_BLOCK_SIZE, 0, B>), grid, dim3(P_NWARPS * 32), 0, s, ab);       \
+    } while (0)
+    if (t == 16) K4_L(16); else if (t == 32) K4_L(32); else K4_L(48);
+#undef K4_L
+    CHK();
+    return 0;
+}
